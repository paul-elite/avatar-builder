{
  "rewrites": [
    { "source": "/a/:seed.svg", "destination": "/api/avatar?seed=:seed" },
    { "source": "/a/:seed.json", "destination": "/api/avatar?seed=:seed&format=json" }
  ],
  "headers": [
    { "source": "/embed.js", "headers": [{ "key": "access-control-allow-origin", "value": "*" }, { "key": "cache-control", "value": "public, max-age=300, s-maxage=3600" }] }
  ]
}
